---
import "@fontsource-variable/overpass/wght.css";
import "@fontsource-variable/overpass/wght-italic.css";
import "@fontsource-variable/overpass-mono/wght.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Report from "../components/Report.astro";
import { site } from "../data/site";

interface Props {
  /** Page title. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Dark page with the map behind it. */
  scene?: boolean;
  footer?: boolean;
  /** Files the page's scripts will ask for, fetched with the HTML instead of after them. */
  preload?: { href: string; as: "fetch" | "image"; media?: string }[];
}

const {
  title,
  description = site.description,
  scene = false,
  footer = true,
  preload = [],
} = Astro.props;
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name}: the survival guide`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      preload.map((file) => (
        <link rel="preload" crossorigin="anonymous" {...file} />
      ))
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {
      scene ? (
        <meta name="theme-color" content="#0b1620" />
      ) : (
        <>
          <meta
            name="theme-color"
            content="#f6f2e8"
            media="(prefers-color-scheme: light)"
          />
          <meta
            name="theme-color"
            content="#0b1620"
            media="(prefers-color-scheme: dark)"
          />
        </>
      )
    }
  </head>
  <body class:list={[{ "theme-scene": scene }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    {footer && <Footer />}
    <Report />
  </body>
</html>
