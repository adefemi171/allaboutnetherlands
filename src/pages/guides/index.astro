---
import { getCollection } from "astro:content";
import Route from "../../components/Route.astro";
import Base from "../../layouts/Base.astro";

const guides = await getCollection("guides");
---

<Base
  title="Guides"
  description="Guides to moving to the Netherlands, in the order you need them: permits, housing, registration, a bank account, health insurance, DigiD and the 30% ruling."
>
  <main id="main" class="wrap guides">
    <header class="guides__head">
      <p class="mono">{guides.length} guides</p>
      <h1>A move to the Netherlands, in the order it happens</h1>
      <p class="guides__lede">
        Start at the top and work down. Each guide says what to do, what to
        bring, what it costs and how long it takes, and lists the official
        pages its facts come from.
      </p>
    </header>
    <Route level={2} />
  </main>
</Base>

<style>
  .guides {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  .guides__head {
    position: sticky;
    top: calc(var(--header-offset) + 1.5rem);
    align-self: start;
  }
  .guides__head h1 {
    margin-top: 0.9rem;
    font-size: clamp(1.85rem, 7vw, 3.3rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.03;
  }
  .guides__lede {
    margin-top: 1.2rem;
    font-size: 1.15rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .guides {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.8rem;
      padding-top: 2rem;
      padding-bottom: calc(2rem + var(--safe-bottom));
    }
    .guides__head {
      position: static;
    }
    .guides__lede {
      font-size: 1.05rem;
    }
  }
</style>
