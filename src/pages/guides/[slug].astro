---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { findPlace } from "../../data/places";
import { reportEndpoint } from "../../data/report";
import { stages } from "../../data/site";

export async function getStaticPaths() {
  const guides = (await getCollection("guides")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const checklist = guides.filter((guide) => !guide.data.supplemental);
  return guides.map((guide) => {
    const index = checklist.indexOf(guide);
    return {
      params: { slug: guide.id },
      props: {
        guide,
        step: index + 1,
        total: checklist.length,
        previous: index >= 0 ? (checklist[index - 1] ?? null) : null,
        next: index >= 0 ? (checklist[index + 1] ?? null) : null,
      },
    };
  });
}

const { guide, step, total, previous, next } = Astro.props;
const { Content, headings } = await render(guide);
const { data } = guide;
const stage = stages[data.stage];
const sections = headings.filter((heading) => heading.depth === 2);
const place = data.place ? findPlace(data.place) : undefined;

const checked = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(data.updated);

/** "ind.nl" from a source URL, to show who publishes it. */
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<Base title={data.title} description={data.summary}>
  <main id="main" class="wrap guide">
    <header class="guide__head">
      <p class="mono">
        <a href="/guides/">Guides</a>{!data.supplemental && ` / ${stage.label} · Step ${step} of ${total}`}
      </p>
      <h1>{data.title}</h1>
      <p class="guide__summary">{data.summary}</p>
      <p class="mono">Checked against official sources on {checked}</p>
    </header>

    <div class="guide__body">
      <article>
        {
          data.keyFacts.length > 0 && (
            <section class="facts" aria-labelledby="facts-title">
              <h2 class="mono" id="facts-title">
                In short
              </h2>
              <dl>
                {data.keyFacts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          place && (
            <p class="guide__place">
              <a href={`/map/?place=${place.id}`}>See {place.name} on the map</a>
            </p>
          )
        }

        {
          data.needsCheck.length > 0 && (
            <section class="open" aria-labelledby="open-title">
              <h2 id="open-title">Not confirmed yet</h2>
              <p>
                On {checked} these points were not yet published, or could
                not be read on an official page. Check the official page
                before you rely on them.
              </p>
              <ul>
                {data.needsCheck.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.sources.length > 0 && (
            <section class="sources" aria-labelledby="sources-title">
              <h2 id="sources-title">Sources</h2>
              <ol>
                {data.sources.map((source) => (
                  <li>
                    <a href={source.url} rel="noopener">
                      {source.title}
                    </a>
                    <span class="mono">{host(source.url)}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          reportEndpoint && (
            <aside class="wrong">
              <p>
                <strong>Is something here wrong or out of date?</strong> Rules
                change, and this guide may not have caught up yet.
              </p>
              <button class="button button--quiet" type="button" data-report-open>
                Report a problem
              </button>
            </aside>
          )
        }
      </article>

      {
        sections.length > 1 && (
          <details class="contents" data-contents open>
            <summary class="mono" id="contents-title">
              On this page
            </summary>
            <nav aria-labelledby="contents-title">
              <ol>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
                {data.needsCheck.length > 0 && (
                  <li>
                    <a href="#open-title">Not confirmed yet</a>
                  </li>
                )}
                {data.sources.length > 0 && (
                  <li>
                    <a href="#sources-title">Sources</a>
                  </li>
                )}
              </ol>
            </nav>
          </details>
        )
      }
    </div>

    <nav class="onward" aria-label="Guide navigation">
      {
        previous ? (
          <a href={`/guides/${previous.id}/`} rel="prev">
            <span class="mono">Previous · Step {step - 1}</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <a href="/guides/">
            <span class="mono">Back to</span>
            <strong>All guides</strong>
          </a>
        )
      }
      {
        next ? (
          <a class="onward__next" href={`/guides/${next.id}/`} rel="next">
            <span class="mono">Next · Step {step + 1}</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : !data.supplemental && (
          <a class="onward__next" href="/map/">
            <span class="mono">Next</span>
            <strong>Explore the map</strong>
          </a>
        )
      }
    </nav>
  </main>
</Base>

<style>
  .guide {
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .guide__head {
    max-width: 46rem;
  }
  .guide__head .mono a {
    color: inherit;
  }
  .guide__head h1 {
    margin-top: 0.9rem;
    font-size: clamp(1.9rem, 7.5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .guide__summary {
    margin-top: 1.1rem;
    max-width: var(--measure);
    font-size: clamp(1.05rem, 3.2vw, 1.25rem);
    line-height: 1.5;
    color: var(--muted);
  }
  .guide__head > .mono:last-child {
    margin-top: 1.4rem;
  }

  .guide__body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* The short version, as a table of facts with a rule under each. */
  .facts {
    border-top: 4px solid var(--text);
  }
  .facts h2 {
    padding-top: 0.8rem;
    font-size: 0.72rem;
    line-height: inherit;
    letter-spacing: 0.08em;
  }
  .facts dl {
    margin: 0.6rem 0 0;
  }
  .facts div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.2rem 1.2rem;
    padding: 0.65rem 0 0.55rem;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .prose {
    margin-top: 2.2rem;
  }
  .prose > :global(* + *) {
    margin-top: 1.05em;
  }
  .prose :global(h2) {
    margin-top: 2.6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 1.65rem;
    letter-spacing: -0.015em;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .prose :global(:is(h2, h3) + *) {
    margin-top: 0.7em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  .prose :global(em) {
    font-style: italic;
  }
  /* Wide tables scroll sideways inside the column, not the page. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .prose :global(th),
  .prose :global(td) {
    min-width: 8rem;
    padding: 0.6rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    border-bottom: 2px solid var(--text);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.1rem;
    border-left: 4px solid var(--line);
    color: var(--muted);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .guide__place {
    margin-top: 2rem;
    font-weight: 600;
  }

  .open,
  .sources {
    margin-top: 3rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .open h2,
  .sources h2 {
    font-size: 1.3rem;
  }
  .open {
    padding: 1.2rem 1.3rem 1.3rem;
    border: 0;
    border-left: 4px solid var(--signal);
    background: var(--mark);
  }
  .open p {
    margin-top: 0.6rem;
  }
  .open ul {
    margin: 0.9rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .open li + li {
    margin-top: 0.55em;
  }
  .sources ol {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: source;
  }
  .sources li {
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    padding: 0.55rem 0 0.45rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    line-height: 1.4;
    counter-increment: source;
  }
  .sources li::before {
    content: counter(source, decimal-leading-zero);
    grid-row: span 2;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .sources li .mono {
    grid-column: 2;
    margin-top: 0.1rem;
    font-size: 0.66rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .wrong {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 4px solid var(--text);
  }
  .wrong p {
    flex: 1 1 16rem;
    line-height: 1.45;
  }

  .contents {
    position: sticky;
    top: calc(var(--header-offset) + 1.5rem);
    align-self: start;
    max-width: 17rem;
    max-height: calc(100dvh - var(--header-offset) - 3rem);
    overflow: auto;
  }
  .contents summary {
    cursor: default;
    list-style: none;
  }
  .contents summary::-webkit-details-marker {
    display: none;
  }
  .contents ol {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    border-left: 4px solid var(--signal);
  }
  .contents a {
    display: block;
    padding: 0.45rem 0 0.4rem 0.9rem;
    color: var(--text);
    font-size: 0.93rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .contents a:hover {
    text-decoration: underline;
  }

  .onward {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin-top: clamp(3rem, 7vw, 5rem);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .onward a {
    display: grid;
    gap: 0.3rem;
    padding: 1.2rem 1.4rem 1.1rem;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
  }
  .onward a:hover {
    background: var(--surface);
  }
  .onward strong {
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .onward__next {
    text-align: right;
  }

  @media (max-width: 900px) {
    .guide__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }
    /* On a narrow screen the contents list comes before the text. */
    .contents {
      position: static;
      grid-row: 1;
      max-width: none;
      max-height: none;
      overflow: visible;
      padding: 0.15rem 0.9rem 0.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .contents summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 2.75rem;
      cursor: pointer;
    }
    .contents summary::after {
      content: "";
      width: 0.55rem;
      height: 0.55rem;
      border-right: 2px solid var(--muted);
      border-bottom: 2px solid var(--muted);
      rotate: 45deg;
      translate: 0 -0.15rem;
      transition: rotate 0.15s;
    }
    .contents[open] summary::after {
      rotate: 225deg;
      translate: 0 0.15rem;
    }
    .contents ol {
      margin: 0.15rem 0 0.7rem;
    }
  }
  @media (max-width: 560px) {
    .guide {
      padding-top: 1.6rem;
      padding-bottom: calc(2rem + var(--safe-bottom));
    }
    .facts div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .prose :global(h2) {
      font-size: 1.4rem;
    }
    .onward {
      grid-template-columns: 1fr;
    }
    .onward a {
      padding: 1.05rem 1.1rem 1rem;
      min-height: 4.5rem;
    }
    .onward__next {
      text-align: left;
    }
    .wrong {
      flex-direction: column;
      align-items: stretch;
    }
    .wrong .button {
      width: 100%;
      justify-content: center;
      min-height: 2.75rem;
    }
  }
</style>

<script>
  const contents = document.querySelector<HTMLDetailsElement>("[data-contents]");
  const narrow = window.matchMedia("(max-width: 900px)");
  if (contents) {
    if (narrow.matches) contents.open = false;
    contents.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (narrow.matches) contents.open = false;
      });
    });
  }
</script>
