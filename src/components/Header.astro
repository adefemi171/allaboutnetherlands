---
import Lion from "./Lion.astro";
import Search from "./Search.astro";
import { footerNav, nav, site } from "../data/site";

const path = Astro.url.pathname;
const menu = [...nav, ...footerNav];

const current = (href: string) =>
  path === href || path.startsWith(href) ? "page" : undefined;
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <Lion />
      <span><span class="wordmark__lead">All About </span>Netherlands</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current(item.href)}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__search">
      <Search id="site-search" />
    </div>
    <button
      class="site-header__menu"
      type="button"
      data-header-menu
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <svg class="site-header__menu-open" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M3 4.5h12M3 9h12M3 13.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <svg class="site-header__menu-close" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M4 4l10 10M14 4 4 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

{/* Outside the header: backdrop-filter would trap position:fixed inside it. */}
<div class="site-menu" id="site-menu" data-site-menu hidden>
  <div class="site-menu__search">
    <Search id="menu-search" />
  </div>
  <nav class="site-menu__nav" aria-label="Site">
    {
      menu.map((item) => (
        <a href={item.href} aria-current={current(item.href)}>
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-header-menu]");
  const panel = document.querySelector<HTMLElement>("[data-site-menu]");
  const field = panel?.querySelector<HTMLInputElement>("#menu-search");
  if (header && toggle && panel) {
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      header.classList.toggle("is-menu", open);
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.body.classList.toggle("has-menu", open);
      if (open) field?.focus();
      else field?.blur();
    };

    toggle.addEventListener("click", () => setOpen(!open));
    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && open) {
        setOpen(false);
        toggle.focus();
      }
      if (
        event.key === "/" &&
        !open &&
        document.activeElement?.tagName !== "INPUT" &&
        document.activeElement?.tagName !== "TEXTAREA" &&
        window.matchMedia("(max-width: 960px)").matches
      ) {
        event.preventDefault();
        setOpen(true);
      }
    });
    window.matchMedia("(min-width: 961px)").addEventListener("change", (event) => {
      if (event.matches && open) setOpen(false);
    });
  }
</script>
